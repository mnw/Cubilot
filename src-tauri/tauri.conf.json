{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cubilot",
  "version": "0.12.0",
  "identifier": "com.mnw.cubilot",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cubilot",
        "width": 980,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost; img-src 'self' http://127.0.0.1:* data: asset: http://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/cubilot-bin"
    ],
    "resources": {
      "resources/tmux": "resources/tmux",
      "resources/pi-extension.js": "resources/pi-extension.js",
      "resources/chatbridge-mod.js": "resources/chatbridge-mod.js",
      "../factory/a11y/": "factory/a11y/",
      "../factory/editor/": "factory/editor/",
      "../factory/orchestrator/": "factory/orchestrator/",
      "../factory/reviewer/": "factory/reviewer/",
      "../factory/seo/": "factory/seo/",
      "../factory/tester/": "factory/tester/",
      "../factory/validator/": "factory/validator/",
      "../factory/worker/": "factory/worker/",
      "../factory/writer/": "factory/writer/",
      "../factory/shared/": "factory/shared/",
      "../factory/licenses/": "factory/licenses/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {}
}
