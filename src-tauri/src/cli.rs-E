// `cubilot hub <METHOD> <path> [json-body]`: one hub request with the human token from the Keychain (Touch ID).
// The app binary runs this instead of the window when its first argument is `hub`. Exit 0 on a 2xx status;
// 1 on a non-2xx status; 2 on a usage error; 3 on a Keychain, hub.url or connection failure (one line names the cause).
// The token is never printed: output and error text pass through `redact`.

use std::io::{Read, Write};
use std::net::{TcpStream, ToSocketAddrs};
use std::path::Path;
use std::time::Duration;

const METHODS: [&str; 5] = ["GET", "POST", "PUT", "PATCH", "DELETE"];
const IO_TIMEOUT: Duration = Duration::from_secs(15);
const BODY_CAP: usize = 8 * 1024 * 1024;

#[derive(Debug, PartialEq, Eq)]
pub(crate) struct HubCall {
    pub method: String,
    pub path: String,
    pub body: Option<String>,
}

pub(crate) fn parse_args(args: &[String]) -> Result<HubCall, String> {
    const USAGE: &str = "usage: cubilot hub <METHOD> <path> [json-body]";
    if args.len() < 2 || args.len() > 3 {
        return Err(USAGE.to_string());
    }
    let method = args[0].to_ascii_uppercase();
    if !METHODS.contains(&method.as_str()) {
        return Err(format!("method must be one of {}", METHODS.join(", ")));
    }
    let path = args[1].clone();
    if !path.starts_with('/') || path.starts_with("//") || path.bytes().any(|b| b <= b' ' || b == 0x7f) {
        return Err("path must start with one / and hold no space or control character".to_string());
    }
    let body = match args.get(2) {
        Some(b) => {
            serde_json::from_str::<serde_json::Value>(b).map_err(|_| "json-body is not valid JSON".to_string())?;
            Some(b.clone())
        }
        None => None,
    };
    Ok(HubCall { method, path, body })
}

// "http://127.0.0.1:PORT" from hub.url. The hub listens on loopback in plain http only.
pub(crate) fn parse_hub_url(raw: &str) -> Result<String, String> {
    let url = raw.trim();
    let rest = url.strip_prefix("http://").ok_or("hub.url is not an http:// address")?;
    let host_port = rest.trim_end_matches('/');
    let (host, port) = host_port.rsplit_once(':').ok_or("hub.url has no port")?;
    if host != "127.0.0.1" && host != "localhost" {
        return Err("hub.url is not a loopback address".to_string());
    }
    if port.parse::<u16>().is_err() {
        return Err("hub.url has a bad port".to_string());
    }
    Ok(host_port.to_string())
}

pub(crate) fn build_request(host_port: &str, call: &HubCall, token: &str) -> String {
    let mut r = format!(
        "{} {} HTTP/1.0\r\nHost: {}\r\nAuthorization: Bearer {}\r\nAccept: application/json\r\n",
        call.method, call.path, host_port, token
    );
    match &call.body {
        Some(b) => r.push_str(&format!("Content-Type: application/json\r\nContent-Length: {}\r\n\r\n{}", b.len(), b)),
        None => r.push_str("\r\n"),
    }
    r
}

fn redact(text: &str, token: &str) -> String {
    if token.is_empty() {
        text.to_string()
    } else {
        text.replace(token, "[redacted]")
    }
}

fn decode_chunked(raw: &[u8]) -> Vec<u8> {
    let mut out = Vec::new();
    let mut i = 0;
    while let Some(nl) = raw[i..].windows(2).position(|w| w == b"\r\n") {
        let size_txt = String::from_utf8_lossy(&raw[i..i + nl]);
        let size = usize::from_str_radix(size_txt.split(';').next().unwrap_or("").trim(), 16).unwrap_or(0);
        i += nl + 2;
        if size == 0 || i + size > raw.len() {
            break;
        }
        out.extend_from_slice(&raw[i..i + size]);
        i += size + 2;
    }
    out
}

// (status, body) of a raw HTTP response.
pub(crate) fn parse_response(raw: &[u8]) -> Result<(u16, String), String> {
    let split = raw.windows(4).position(|w| w == b"\r\n\r\n").ok_or("the hub sent no HTTP response")?;
    let head = String::from_utf8_lossy(&raw[..split]).to_string();
    let status = head
        .lines()
        .next()
        .and_then(|l| l.split_whitespace().nth(1))
        .and_then(|s| s.parse::<u16>().ok())
        .ok_or("the hub sent no HTTP status")?;
    let body = &raw[split + 4..];
    let chunked = head.to_ascii_lowercase().contains("transfer-encoding: chunked");
    let bytes = if chunked { decode_chunked(body) } else { body.to_vec() };
    Ok((status, String::from_utf8_lossy(&bytes).to_string()))
}

fn send(host_port: &str, request: &str) -> Result<Vec<u8>, String> {
    let addr = host_port
        .to_socket_addrs()
        .ok()
        .and_then(|mut a| a.next())
        .ok_or("hub.url does not resolve")?;
    let mut s = TcpStream::connect_timeout(&addr, IO_TIMEOUT).map_err(|_| format!("hub does not answer at {host_port}"))?;
    let _ = s.set_read_timeout(Some(IO_TIMEOUT));
    let _ = s.set_write_timeout(Some(IO_TIMEOUT));
    s.write_all(request.as_bytes()).map_err(|_| format!("hub does not answer at {host_port}"))?;
    let mut raw = Vec::new();
    s.take(BODY_CAP as u64)
        .read_to_end(&mut raw)
        .map_err(|_| format!("hub did not finish its answer at {host_port}"))?;
    Ok(raw)
}

// token_source is the Keychain read in the app, a fake in the tests. Its Err is one line without a token.
pub(crate) fn run(
    args: &[String],
    data_dir: &Path,
    presence_gate: &dyn Fn() -> Result<(), String>,
    token_source: &dyn Fn() -> Result<String, String>,
    out: &mut dyn Write,
    err: &mut dyn Write,
) -> i32 {
    let call = match parse_args(args) {
        Ok(c) => c,
        Err(e) => {
            let _ = writeln!(err, "cubilot hub: {e}");
            return 2;
        }
    };
    let host_port = match std::fs::read_to_string(data_dir.join("hub.url")) {
        Ok(raw) => match parse_hub_url(&raw) {
            Ok(h) => h,
            Err(e) => {
                let _ = writeln!(err, "cubilot hub: {e}");
                return 3;
            }
        },
        Err(_) => {
            let _ = writeln!(err, "cubilot hub: no hub.url in the app data folder (the Cubilot app is not running)");
            return 3;
        }
    };
    // The presence gate runs BEFORE the Keychain read: the file keychain alone shows no prompt to its own app.
    if let Err(e) = presence_gate() {
        let _ = writeln!(err, "cubilot hub: {}", e.lines().next().unwrap_or("presence check refused"));
        return 3;
    }
    let token = match token_source() {
        Ok(t) => t,
        Err(e) => {
            let _ = writeln!(err, "cubilot hub: {}", e.lines().next().unwrap_or("Keychain error"));
            return 3;
        }
    };
    let request = build_request(&host_port, &call, &token);
    let raw = match send(&host_port, &request) {
        Ok(r) => r,
        Err(e) => {
            let _ = writeln!(err, "cubilot hub: {}", redact(&e, &token));
            return 3;
        }
    };
    match parse_response(&raw) {
        Ok((status, body)) => {
            let _ = writeln!(out, "HTTP {status}");
            let _ = writeln!(out, "{}", redact(body.trim_end(), &token));
            if (200..300).contains(&status) {
                0
            } else {
                1
            }
        }
        Err(e) => {
            let _ = writeln!(err, "cubilot hub: {}", redact(&e, &token));
            3
        }
    }
}

// Entry for main.rs: the real Keychain and the real app data folder.
pub fn run_from_env(args: &[String]) -> i32 {
    let source = || crate::keychain::read_human_token().map_err(|e| e.describe());
    let gate = || crate::presence::require_presence("read the Cubilot human token");
    run(
        args,
        &crate::app_data_dir(),
        &gate,
        &source,
        &mut std::io::stdout(),
        &mut std::io::stderr(),
    )
}

#[cfg(test)]
mod tests {
    use super::*;
    use std::net::TcpListener;

    const FAKE: &str = "FAKE-TOKEN-not-a-real-credential-0123456789abcdef";

    fn v(a: &[&str]) -> Vec<String> {
        a.iter().map(|s| s.to_string()).collect()
    }

    #[test]
    fn parse_accepts_method_path_and_optional_json() {
        let c = parse_args(&v(&["post", "/tickets/t_1/transition", "{\"to\":\"queued\"}"])).unwrap();
        assert_eq!(c.method, "POST");
        assert_eq!(c.path, "/tickets/t_1/transition");
        assert_eq!(c.body.as_deref(), Some("{\"to\":\"queued\"}"));
        let g = parse_args(&v(&["GET", "/agents"])).unwrap();
        assert_eq!(g.body, None);
    }

    #[test]
    fn parse_refuses_bad_input() {
        assert!(parse_args(&v(&[])).is_err());
        assert!(parse_args(&v(&["GET"])).is_err());
        assert!(parse_args(&v(&["GET", "/a", "{}", "x"])).is_err());
        assert!(parse_args(&v(&["TRACE", "/a"])).is_err());
        assert!(parse_args(&v(&["GET", "agents"])).is_err());
        assert!(parse_args(&v(&["GET", "//evil.example/x"])).is_err());
        assert!(parse_args(&v(&["GET", "/a b"])).is_err());
        assert!(parse_args(&v(&["GET", "/a\r\nX: y"])).is_err());
        assert!(parse_args(&v(&["POST", "/a", "{not json"])).is_err());
    }

    #[test]
    fn hub_url_must_be_loopback_http_with_a_port() {
        assert_eq!(parse_hub_url("http://127.0.0.1:8011\n").unwrap(), "127.0.0.1:8011");
        assert!(parse_hub_url("https://127.0.0.1:8011").is_err());
        assert!(parse_hub_url("http://example.com:80").is_err());
        assert!(parse_hub_url("http://127.0.0.1").is_err());
        assert!(parse_hub_url("http://127.0.0.1:abc").is_err());
    }

    #[test]
    fn the_request_carries_the_bearer_and_the_body() {
        let c = HubCall { method: "POST".into(), path: "/x".into(), body: Some("{\"a\":1}".into()) };
        let r = build_request("127.0.0.1:1", &c, FAKE);
        assert!(r.starts_with("POST /x HTTP/1.0\r\n"));
        assert!(r.contains(&format!("Authorization: Bearer {FAKE}\r\n")));
        assert!(r.contains("Content-Length: 7\r\n"));
        assert!(r.ends_with("\r\n\r\n{\"a\":1}"));
        let g = build_request("127.0.0.1:1", &HubCall { method: "GET".into(), path: "/agents".into(), body: None }, FAKE);
        assert!(g.ends_with("\r\n\r\n") && !g.contains("Content-Length"));
    }

    #[test]
    fn response_parse_handles_length_and_chunked() {
        let (s, b) = parse_response(b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\n[]").unwrap();
        assert_eq!((s, b.as_str()), (200, "[]"));
        let (s, b) = parse_response(b"HTTP/1.1 409 Conflict\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n2\r\nde\r\n0\r\n\r\n").unwrap();
        assert_eq!((s, b.as_str()), (409, "abcde"));
        assert!(parse_response(b"garbage").is_err());
    }

    // A one-shot fake hub. Returns (data dir with hub.url, request text of the one request).
    fn fake_hub(status_line: &str, body: &str) -> (std::path::PathBuf, std::thread::JoinHandle<String>) {
        let l = TcpListener::bind("127.0.0.1:0").unwrap();
        let port = l.local_addr().unwrap().port();
        let dir = std::env::temp_dir().join(format!("cubilot-cli-{port}-{}", std::process::id()));
        std::fs::create_dir_all(&dir).unwrap();
        std::fs::write(dir.join("hub.url"), format!("http://127.0.0.1:{port}")).unwrap();
        let resp = format!("{status_line}\r\nContent-Length: {}\r\n\r\n{body}", body.len());
        let h = std::thread::spawn(move || {
            let (mut s, _) = l.accept().unwrap();
            let mut buf = [0u8; 4096];
            let n = s.read(&mut buf).unwrap();
            s.write_all(resp.as_bytes()).unwrap();
            String::from_utf8_lossy(&buf[..n]).to_string()
        });
        (dir, h)
    }

    #[test]
    fn run_prints_status_and_body_and_sends_the_bearer() {
        let (dir, h) = fake_hub("HTTP/1.1 200 OK", "[{\"name\":\"a\"}]");
        let (mut out, mut err) = (Vec::new(), Vec::new());
        let code = run(&v(&["GET", "/agents"]), &dir, &|| Ok(FAKE.to_string()), &mut out, &mut err);
        let seen = h.join().unwrap();
        assert_eq!(code, 0);
        assert_eq!(String::from_utf8(out).unwrap(), "HTTP 200\n[{\"name\":\"a\"}]\n");
        assert!(err.is_empty());
        assert!(seen.contains(&format!("Authorization: Bearer {FAKE}")));
        let _ = std::fs::remove_dir_all(&dir);
    }

    #[test]
    fn a_non_2xx_status_exits_1_and_an_echoed_token_is_redacted() {
        let (dir, h) = fake_hub("HTTP/1.1 403 Forbidden", &format!("{{\"error\":\"bad {FAKE}\"}}"));
        let (mut out, mut err) = (Vec::new(), Vec::new());
        let code = run(&v(&["GET", "/x"]), &dir, &|| Ok(FAKE.to_string()), &mut out, &mut err);
        h.join().unwrap();
        assert_eq!(code, 1);
        let text = String::from_utf8(out).unwrap();
        assert!(text.starts_with("HTTP 403\n") && !text.contains(FAKE) && text.contains("[redacted]"));
        let _ = std::fs::remove_dir_all(&dir);
    }

    #[test]
    fn failures_exit_3_with_one_line_that_names_the_cause_and_no_token() {
        // No hub.url.
        let empty = std::env::temp_dir().join(format!("cubilot-cli-empty-{}", std::process::id()));
        std::fs::create_dir_all(&empty).unwrap();
        let (mut out, mut err) = (Vec::new(), Vec::new());
        assert_eq!(run(&v(&["GET", "/a"]), &empty, &|| Ok(FAKE.into()), &mut out, &mut err), 3);
        let e = String::from_utf8(err).unwrap();
        assert!(e.contains("no hub.url") && e.lines().count() == 1 && !e.contains(FAKE));
        // No Keychain item, then a refused prompt.
        let (dir, _h) = fake_hub("HTTP/1.1 200 OK", "");
        for cause in ["no Keychain item for the human token", "Touch ID or password prompt refused"] {
            let (mut out, mut err) = (Vec::new(), Vec::new());
            assert_eq!(run(&v(&["GET", "/a"]), &dir, &|| Err(cause.to_string()), &mut out, &mut err), 3);
            let e = String::from_utf8(err).unwrap();
            assert!(e.contains(cause) && e.lines().count() == 1);
            assert!(out.is_empty());
        }
        // Hub that does not answer: a port with no listener.
        let dead = std::env::temp_dir().join(format!("cubilot-cli-dead-{}", std::process::id()));
        std::fs::create_dir_all(&dead).unwrap();
        let port = { TcpListener::bind("127.0.0.1:0").unwrap().local_addr().unwrap().port() };
        std::fs::write(dead.join("hub.url"), format!("http://127.0.0.1:{port}")).unwrap();
        let (mut out, mut err) = (Vec::new(), Vec::new());
        assert_eq!(run(&v(&["GET", "/a"]), &dead, &|| Ok(FAKE.into()), &mut out, &mut err), 3);
        let e = String::from_utf8(err).unwrap();
        assert!(e.contains("hub does not answer") && e.lines().count() == 1 && !e.contains(FAKE));
        let _ = std::fs::remove_dir_all(&empty);
        let _ = std::fs::remove_dir_all(&dead);
    }

    #[test]
    fn the_presence_gate_runs_before_the_token_source_and_a_refusal_exits_3() {
        let (dir, _h) = fake_hub("HTTP/1.1 200 OK", "");
        let (mut out, mut err) = (Vec::new(), Vec::new());
        let code = run(
            &v(&["GET", "/a"]),
            &dir,
            &|| Err("Touch ID or password prompt refused".to_string()),
            &|| panic!("token read before the presence gate"),
            &mut out,
            &mut err,
        );
        assert_eq!(code, 3);
        let e = String::from_utf8(err).unwrap();
        assert!(e.contains("refused") && e.lines().count() == 1 && out.is_empty());
        // Order: gate first, then token source.
        let order = std::cell::RefCell::new(Vec::new());
        let (mut out, mut err) = (Vec::new(), Vec::new());
        run(
            &v(&["GET", "/a"]),
            &dir,
            &|| { order.borrow_mut().push("gate"); Ok(()) },
            &|| { order.borrow_mut().push("token"); Err("no Keychain item".to_string()) },
            &mut out,
            &mut err,
        );
        assert_eq!(*order.borrow(), vec!["gate", "token"]);
        let _ = std::fs::remove_dir_all(&dir);
    }

    #[test]
    fn usage_errors_exit_2_before_any_token_read() {
        let (mut out, mut err) = (Vec::new(), Vec::new());
        let code = run(&v(&["GET"]), Path::new("/nonexistent"), &|| Ok(()), &|| panic!("token read"), &mut out, &mut err);
        assert_eq!(code, 2);
    }
}
