{
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "bun-types"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "hub/**/*.ts",
    "ui/**/*.ts"
  ],
  "exclude": [
    "hub/channel/claude-mod/**"
  ]
}
